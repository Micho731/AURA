# Copy this file to .env and fill in your own values. Never commit .env.
OPENAI_API_KEY=your-openai-api-key

# Who the kiosk serves (shown in answers and used by the scrapers)
INSTITUTION_NAME=Example University
FACULTY_NAME=Faculty of Engineering and Computer Science
CAMPUSES=Main Campus, North Campus, South Campus
HOME_CAMPUS=Main Campus
FOE_SCRAPE_URL=https://www.example.edu

# Optional model overrides
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_EMBED_MODEL=text-embedding-3-small
# WHISPER_MODEL=base

# Optional Web Push for the instructor app (needs HTTPS)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
